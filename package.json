{
  "name": "iobroker.wireless-mbus",
  "version": "0.13.1",
  "description": "Receive data from Wireless Meter-Bus (wM-Bus) devices like gas or electricity meters",
  "author": {
    "name": "Christian Landvogt",
    "email": "chris@lvgt.de"
  },
  "homepage": "https://github.com/lvogt/ioBroker.wireless-mbus",
  "license": "GPL-2.0-only",
  "keywords": [
    "ioBroker",
    "wmbus",
    "measure",
    "mbus",
    "wireless",
    "meter",
    "oms"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvogt/ioBroker.wireless-mbus.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "serialport": "^13.0.0",
    "wireless-mbus-parser": "^1.5.0"
  },
  "files": [
    "build/",
    "io-package.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "admin/wireless-mbus.png",
    "admin/jsonConfig.json",
    "admin/i18n/"
  ],
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.1",
    "@iobroker/types": "^7.2.2",
    "@serialport/binding-mock": "^10.2.2",
    "@serialport/stream": "^13.0.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@types/source-map-support": "^0.5.10",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "scripts": {
    "prebuild": "rimraf build",
    "build": "build-adapter ts",
    "watch": "build-adapter ts --watch",
    "test:unit": "mocha --config test/mocharc.custom.json \"{src/**/*.test.ts,test/**/*.test.ts,test/**/*.test.js}\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:unit && npm run test:package",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/lvogt/ioBroker.wireless-mbus/issues"
  },
  "readmeFilename": "README.md"
}
