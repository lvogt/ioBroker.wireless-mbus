// Root tsconfig: type checking for everything, no emit.
// The compilation itself is configured in tsconfig.build.json.
{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,

        // the test helpers and the admin config are still JavaScript
        "allowJs": true,
        "checkJs": true,

        // necessary for the automatic typing of the adapter config
        "resolveJsonModule": true,

        // dependency .d.ts files are not ours to fix
        "skipLibCheck": true,

        // Global type packages are not reachable through an import, so they
        // have to be listed: "mocha" provides describe/it for the tests.
        "types": ["node", "mocha"],

        // esbuild transpiles one file at a time, which quietly breaks the
        // TypeScript constructs that need cross-file information - const enums
        // and merged namespaces above all. This rejects every construct that
        // cannot simply be erased, so what is written always survives the
        // build. It is also what would be needed to run the sources directly
        // under node's type stripping.
        "erasableSyntaxOnly": true,

        // relaxed while the sources are being converted; tighten per module
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false,

        "sourceMap": true,
        "inlineSourceMap": false
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts", "test/**/*.js", "*.mjs"],
    "exclude": ["node_modules/**", "build/**", ".dev-server/**", "admin/words.js"]
}
